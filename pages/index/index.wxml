<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <view class="header-text">
      <text class="title">墨水屏传输</text>
      <text class="subtitle">EINK 电子墨水屏 · 蓝牙图片管理</text>
    </view>
    <view class="status-pill {{connected ? 'is-on' : (bluetoothReady ? 'is-ready' : 'is-off')}}">
      <view class="dot"></view>
      <text>{{connected ? '已连接' : (bluetoothReady ? '待连接' : '蓝牙关闭')}}</text>
    </view>
  </view>

  <!-- 标签页切换 -->
  <view class="tabs">
    <view class="tab {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      <text>设备与图片</text>
    </view>
    <view class="tab {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      <text>图片处理</text>
    </view>
  </view>

  <!-- 蓝牙连接面板 -->
  <view class="tab-content" wx:if="{{currentTab === 0}}">
    <!-- 操作按钮 -->
    <view class="actions">
      <button class="action-btn" wx:if="{{!bluetoothReady}}" type="primary" bindtap="initBluetooth">开启蓝牙</button>
      <button class="action-btn" wx:if="{{bluetoothReady && !searching}}" type="default" bindtap="startSearch">扫描设备</button>
      <button class="action-btn" wx:if="{{searching}}" type="warn" bindtap="stopSearch">停止扫描</button>
      <button class="action-btn" wx:if="{{connected}}" type="warn" bindtap="disconnect">断开连接</button>
    </view>

    <!-- 搜索状态 -->
    <view wx:if="{{searching}}" class="searching">
      <view class="loading"></view>
      <text>正在扫描附近设备…</text>
    </view>

    <!-- 设备列表 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">设备</text>
        <text class="card-hint">只显示 EINK 墨水屏</text>
      </view>

      <scroll-view scroll-y class="scroll-area">
        <view
          wx:for="{{devices}}"
          wx:key="deviceId"
          class="device-item {{connected && item.deviceId === currentDeviceId ? 'active' : ''}}"
          bindtap="connectDevice"
          data-device="{{item}}"
        >
          <view class="device-info">
            <text class="device-name">{{item.name || '未命名设备'}}</text>
            <text class="device-id">{{item.deviceId}}</text>
          </view>
          <view class="device-meta">
            <view class="rssi rssi-{{item.signal}}">
              <text>{{item.RSSI}} dBm</text>
            </view>
            <view class="device-status">
              <text>{{connected && item.deviceId === currentDeviceId ? '已连接' : '连接'}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{devices.length === 0}}" class="empty">
          <text>{{searching ? '扫描中…' : '未发现设备，点击扫描'}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 文件管理 -->
    <view wx:if="{{connected && notifyEnabled}}" class="card">
      <view class="card-head">
        <text class="card-title">设备上的图片</text>
        <text class="chip-btn" bindtap="requestFileList">{{loadingFiles ? '刷新中…' : '刷新'}}</text>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{loadingFiles}}" class="file-loading">
        <view class="loading"></view>
        <text>加载中…</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{fileTotal === 0}}" class="file-empty">
        <text>还没有图片，去"图片处理"里传一张</text>
      </view>

      <!-- 文件列表：只渲染窗口内的行，滚到底再放出下一屏 -->
      <scroll-view wx:else scroll-y class="file-scroll"
                   bindscrolltolower="onFileListScrollToLower" lower-threshold="80">
        <view wx:for="{{visibleFiles}}" wx:key="stem" class="file-row">
          <image wx:if="{{item.thumb}}" class="file-thumb" src="{{item.thumb}}" mode="aspectFill" />
          <view wx:else class="file-thumb file-thumb-empty"></view>
          <view class="file-info">
            <text class="file-label">{{item.label}}</text>
            <text class="file-size">{{item.size}}</text>
          </view>
          <view class="file-actions">
            <view class="chip-btn chip-primary" bindtap="selectImage" data-stem="{{item.stem}}">显示</view>
            <view class="chip-btn chip-danger" bindtap="deleteImage" data-stem="{{item.stem}}">删除</view>
          </view>
        </view>
        <view wx:if="{{renderedCount < fileTotal}}" class="file-more">
          <text>已显示 {{renderedCount}} / {{fileTotal}}，上滑加载更多</text>
        </view>
      </scroll-view>
    </view>

    <!-- 轮播设置 -->
    <view wx:if="{{connected && notifyEnabled}}" class="card">
      <view class="card-head">
        <text class="card-title">自动轮播</text>
        <switch class="card-switch" checked="{{slideshowEnabled}}" bindchange="onSlideshowToggle" />
      </view>
      <view class="slideshow-row">
        <text class="slideshow-label">间隔</text>
        <text class="slideshow-value">{{slideshowLabel}}</text>
      </view>
      <view class="preset-list">
        <view wx:for="{{intervalPresets}}" wx:key="seconds"
              class="preset {{slideshowInterval === item.seconds ? 'active' : ''}}"
              bindtap="selectInterval" data-seconds="{{item.seconds}}">{{item.label}}</view>
      </view>
      <text class="preset-hint">这个间隔同时是设备的休眠间隔：越长越省电</text>
    </view>
  </view>

  <!-- 图片处理面板 -->
  <view class="tab-content" wx:if="{{currentTab === 1}}">
    <!-- 选择图片 -->
    <view class="card image-section">
      <button class="btn-choose" bindtap="chooseImage">
        <text>{{imageSrc ? '重新选择图片' : '选择图片'}}</text>
      </button>

      <!-- 尺寸选择 -->
      <view class="crop-size-selector" wx:if="{{imageSrc}}">
        <view class="size-option {{cropWidth === 800 ? 'active' : ''}}" bindtap="selectCropSize" data-size="800">
          <text class="size-name">横屏</text>
          <text class="size-value">800×480</text>
        </view>
        <view class="size-option {{cropWidth === 480 ? 'active' : ''}}" bindtap="selectCropSize" data-size="480">
          <text class="size-name">竖屏</text>
          <text class="size-value">480×800</text>
        </view>
      </view>

      <!-- 裁剪按钮 -->
      <button class="btn-crop" wx:if="{{imageSrc}}" bindtap="cropImage">
        <text>裁剪 ({{cropWidth}}×{{cropHeight}})</text>
      </button>

      <!-- 原图预览 -->
      <view class="preview-box" wx:if="{{imageSrc}}">
        <text class="preview-label">当前图片</text>
        <image class="preview-img" src="{{imageSrc}}" mode="aspectFit" />
      </view>
    </view>

    <!-- 抖动算法选择 -->
    <view class="card dither-section" wx:if="{{imageSrc}}">
      <view class="card-head">
        <text class="card-title">抖动算法</text>
        <text class="chip-btn" bindtap="toggleEnhancePanel">{{showEnhance ? '收起参数' : '调整参数'}}</text>
      </view>

      <view class="algorithm-list">
        <view
          wx:for="{{algorithms}}"
          wx:key="id"
          class="algo-item {{selectedAlgo === item.id ? 'active' : ''}}"
          bindtap="selectAlgo"
          data-id="{{item.id}}"
        >
          <text class="algo-name">{{item.name}}</text>
          <text class="algo-desc">{{item.desc}}</text>
        </view>
      </view>

      <!-- 增强参数面板 -->
      <view class="enhance-panel" wx:if="{{showEnhance}}">
        <view class="param-row">
          <text class="param-label">亮度 {{enhanceParams.brightness}}</text>
          <slider class="param-slider" min="0.5" max="1.5" step="0.05" value="{{enhanceParams.brightness}}" data-key="brightness"
                  bindchanging="onParamChange" bindchange="onParamChange" />
        </view>
        <view class="param-row">
          <text class="param-label">对比度 {{enhanceParams.contrast}}</text>
          <slider class="param-slider" min="0.5" max="1.5" step="0.05" value="{{enhanceParams.contrast}}" data-key="contrast"
                  bindchanging="onParamChange" bindchange="onParamChange" />
        </view>
        <view class="param-row">
          <text class="param-label">饱和度 {{enhanceParams.saturation}}</text>
          <slider class="param-slider" min="0.5" max="2" step="0.05" value="{{enhanceParams.saturation}}" data-key="saturation"
                  bindchanging="onParamChange" bindchange="onParamChange" />
        </view>
        <view class="param-row">
          <text class="param-label">Gamma {{enhanceParams.gamma}}</text>
          <slider class="param-slider" min="0.3" max="1.5" step="0.05" value="{{enhanceParams.gamma}}" data-key="gamma"
                  bindchanging="onParamChange" bindchange="onParamChange" />
        </view>
        <button class="btn-reset" bindtap="resetParams">重置参数</button>
      </view>

      <!-- 处理结果：参数改了就实时更新，不需要再点应用 -->
      <view class="result-box" wx:if="{{processedSrc}}">
        <text class="preview-label">处理结果 · 7 色墨水屏（实时预览）</text>
        <image class="preview-img" src="{{processedSrc}}" mode="aspectFit" />
        <view class="result-actions">
          <button class="btn-action" bindtap="saveImage">保存图片</button>
          <button class="btn-action btn-send" wx:if="{{connected}}" bindtap="sendToDevice" loading="{{sending}}" disabled="{{sending}}">
            {{sending ? '发送中 ' + sendProgress + '%' : '发送到设备'}}
          </button>
        </view>
        <view wx:if="{{sending}}" class="progress-bar">
          <view class="progress-fill" style="width: {{sendProgress}}%"></view>
          <text class="progress-text">{{sendProgress}}%</text>
        </view>
      </view>
    </view>
  </view>
</view>
