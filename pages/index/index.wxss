/* pages/index/index.wxss
 *
 * 一套简单的一致性规则：
 *   页面底色 #f2f3f5，内容一律白卡片（20rpx 圆角 + 极淡阴影）
 *   主色 #07c160，正文 #1f2329，次要 #646a73，弱化 #8f959e
 *   圆角：卡片 20rpx，控件 12rpx，小标签 999rpx（胶囊）
 */

page {
  background: #f2f3f5;
}

/* 微信默认 button 自带边框和最小高度，这里统一清掉，改用下面的类自己定义 */
button {
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: 28rpx;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: none;
}

.container {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 顶部 ============ */

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 28rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f2329;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #8f959e;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef0f3;
  color: #646a73;
}

.status-pill .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b8bec7;
}

.status-pill.is-ready {
  background: #eef7ef;
  color: #07c160;
}

.status-pill.is-ready .dot {
  background: #07c160;
}

.status-pill.is-on {
  background: #07c160;
  color: #fff;
}

.status-pill.is-on .dot {
  background: #fff;
}

/* ============ 标签页 ============ */

.tabs {
  display: flex;
  padding: 6rpx;
  background: #e8eaed;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 27rpx;
  color: #646a73;
  border-radius: 12rpx;
  transition: all .18s ease;
}

.tab.active {
  background: #fff;
  color: #1f2329;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, .08);
}

.tab-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ============ 通用卡片 ============ */

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, .05);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.card-hint {
  font-size: 22rpx;
  color: #8f959e;
}

.card-switch {
  transform: scale(.85);
}

/* 胶囊小按钮：替代原来笨重的 button，行内操作都用它 */
.chip-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #646a73;
  background: #f0f2f5;
  line-height: 1.4;
}

.chip-primary {
  background: #eef7ef;
  color: #07c160;
}

.chip-danger {
  background: #fdeeee;
  color: #e34d4d;
}

/* ============ 操作按钮 ============ */

.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 500;
  color: #fff;
  background: #07c160;
}

.action-btn[type="warn"] {
  background: #f5a623;
}

.searching {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #646a73;
}

.loading {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #d8dce1;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============ 设备列表 ============ */

.scroll-area {
  max-height: 520rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  margin-bottom: 14rpx;
}

.device-item:last-child {
  margin-bottom: 0;
}

.device-item.active {
  background: #eef7ef;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.device-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1f2329;
}

.device-id {
  font-size: 20rpx;
  color: #a2a8b0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

/* 信号强弱用颜色区分，扫一眼就知道哪个设备靠得近 */
.rssi {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.rssi-strong {
  background: #eef7ef;
  color: #07c160;
}

.rssi-medium {
  background: #fff6e8;
  color: #d98b00;
}

.rssi-weak {
  background: #f0f2f5;
  color: #8f959e;
}

.device-status {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #fff;
  background: #07c160;
}

.device-item.active .device-status {
  background: #b8bec7;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 25rpx;
  color: #a2a8b0;
}

/* ============ 文件列表 ============ */

.file-scroll {
  max-height: 720rpx;
}

.file-loading,
.file-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
  font-size: 25rpx;
  color: #a2a8b0;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  margin-bottom: 14rpx;
}

.file-row:last-child {
  margin-bottom: 0;
}

.file-thumb {
  width: 128rpx;
  height: 76rpx;
  border-radius: 10rpx;
  background: #e8eaed;
  flex-shrink: 0;
}

.file-thumb-empty {
  border: 2rpx dashed #d8dce1;
  background: #fff;
}

.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.file-label {
  font-size: 27rpx;
  font-weight: 500;
  color: #1f2329;
}

.file-size {
  font-size: 21rpx;
  color: #8f959e;
}

.file-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.file-more {
  text-align: center;
  padding: 22rpx 0 6rpx;
  font-size: 22rpx;
  color: #a2a8b0;
}

/* ============ 轮播设置 ============ */

.slideshow-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 12rpx;
}

.slideshow-label {
  font-size: 26rpx;
  color: #646a73;
}

.slideshow-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #07c160;
}

.slideshow-bound {
  font-size: 20rpx;
  color: #a2a8b0;
}

.slideshow-slider {
  flex: 1;
  margin: 0 8rpx;
}

/* ============ 图片处理 ============ */

.image-section,
.dither-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-choose {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  color: #07c160;
  background: #eef7ef;
  border: 2rpx dashed #a8e0bb;
}

.crop-size-selector {
  display: flex;
  gap: 16rpx;
}

.size-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
}

.size-option.active {
  background: #eef7ef;
  border-color: #07c160;
}

.size-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1f2329;
}

.size-value {
  font-size: 21rpx;
  color: #8f959e;
}

.btn-crop {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #1f2329;
  background: #f0f2f5;
}

.preview-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preview-label {
  font-size: 23rpx;
  color: #8f959e;
}

.preview-img {
  width: 100%;
  height: 380rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.algorithm-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.algo-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
}

.algo-item.active {
  background: #eef7ef;
  border-color: #07c160;
}

.algo-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1f2329;
}

.algo-desc {
  font-size: 21rpx;
  color: #8f959e;
}

.enhance-panel {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.param-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.param-label {
  font-size: 23rpx;
  color: #646a73;
}

.param-slider {
  margin: 0;
}

.btn-reset {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 8rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #646a73;
  background: #fff;
}

.result-box {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #1f2329;
  background: #f0f2f5;
}

.btn-send {
  color: #fff;
  background: #07c160;
}

.btn-send[disabled] {
  background: #b8bec7;
  color: #fff;
}

.progress-bar {
  position: relative;
  height: 40rpx;
  border-radius: 999rpx;
  background: #eef0f3;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07c160;
  transition: width .2s ease;
}

.progress-text {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #1f2329;
}
